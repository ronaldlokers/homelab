{
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  "features": {
    "ghcr.io/devcontainers-extra/features/neovim-homebrew:1": {}
  },
  "onCreateCommand": "sudo chsh -s /usr/bin/zsh $USER",
  // mise.toml is the single source of truth for this repo's tooling, so the
  // container installs it up front instead of waiting for someone to type
  // `mise install`. mise is fetched with curl here because DevPod clones the
  // dotfiles *after* postCreateCommand, so the pinned ~/.local/bin/mise the
  // dotfiles install does not exist yet — the chezmoi external overwrites this
  // one with the pinned version a few seconds later, same path.
  "postCreateCommand": "curl -fsSL https://mise.run | sh && $HOME/.local/bin/mise trust --quiet && $HOME/.local/bin/mise install --yes",
  "remoteEnv": {
    // Trust declaratively rather than only via the state file `mise trust`
    // writes: this also covers the mise.toml `enter` hook and any non-login
    // process, and survives a wiped state dir.
    "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}"
  },
  "mounts": [
    "source=${localEnv:HOME}/.kube,target=/home/vscode/.kube,type=bind,consistency=cached"
  ],
  "settings": {
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.profiles.linux": {
      "zsh": {
        "path": "/usr/bin/zsh"
      }
    }
  },
  "forwardPorts": [8080]
}
