logging {
  level = "info"
  format = "logfmt"
}

loki.write "default" {
  endpoint {
    url = "http://loki-write.monitoring.svc.cluster.local:3100/loki/api/v1/push"
  }
}

// loki.relabel promotes journal metadata to real Loki labels. Journal fields
// arrive as __journal_* and are dropped unless explicitly mapped here.
loki.relabel "journal" {
  // Rules are consumed by loki.source.journal below via relabel_rules, so this
  // component forwards nothing itself.
  forward_to = []

  // "unit" is what makes per-service querying possible, e.g. {unit="k3s.service"}.
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "node_name"
  }

  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

// loki.source.journal reads the systemd journal directly.
//
// This replaces a loki.source.file tailing /var/log/syslog, which silently
// collected nothing: Debian Trixie ships journald only, rsyslog is not
// installed, and /var/log/syslog does not exist on these nodes. The target
// never matched, so no node-level or systemd-unit log has ever reached Loki --
// including everything k3s writes. Pod logs were unaffected; they arrive via
// loki.source.kubernetes below, which uses the Kubernetes API rather than files.
//
// Requires the host /var/log and /run/log/journal mounts plus /etc/machine-id,
// all set in release.yaml. Alloy runs as root, so no added privileges are
// needed to read the journal (root:systemd-journal).
//
// "path" is deliberately unset. journald here runs in volatile mode: /var/log/journal
// exists but is empty, and the live journal is /run/log/journal/<machine-id>/
// on tmpfs. Hardcoding /var/log/journal reads an empty directory and silently
// collects nothing -- a healthy component with target_lines_total stuck at 0.
// With path unset, sdjournal resolves /run vs /var itself, so this keeps working
// if journald is later switched to persistent storage.
//
// Volatile means the journal does not survive a reboot. Alerting is unaffected
// (it reads current entries), but post-incident forensics across a reboot needs
// journald made persistent on the nodes -- a host change, not a repo one.
loki.source.journal "node_logs" {
  // Bounds backfill on restart: without this Alloy would re-read the entire
  // retained journal and republish it to Loki as freshly-ingested lines.
  // Loki rejects entries older than its out-of-order window regardless, so
  // anything beyond that is dropped with a 400 rather than ingested.
  max_age       = "12h"
  relabel_rules = loki.relabel.journal.rules
  labels        = {
    job     = "node/journal",
    cluster = "production",
  }
  forward_to = [loki.write.default.receiver]
}

// discovery.kubernetes allows you to find scrape targets from Kubernetes resources.
// It watches cluster state and ensures targets are continually synced with what is currently running in your cluster.
discovery.kubernetes "pod" {
  role = "pod"
  // Restrict to pods on the node to reduce cpu & memory usage
  selectors {
    role = "pod"
    field = "spec.nodeName=" + coalesce(sys.env("HOSTNAME"), constants.hostname)
  }
}

// discovery.relabel rewrites the label set of the input targets by applying one or more relabeling rules.
// If no rules are defined, then the input targets are exported as-is.
discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pod.targets

  // Label creation - "namespace" field from "__meta_kubernetes_namespace"
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    action = "replace"
    target_label = "namespace"
  }

  // Label creation - "pod" field from "__meta_kubernetes_pod_name"
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    action = "replace"
    target_label = "pod"
  }

  // Label creation - "container" field from "__meta_kubernetes_pod_container_name"
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    action = "replace"
    target_label = "container"
  }

  // Label creation -  "app" field from "__meta_kubernetes_pod_label_app_kubernetes_io_name"
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    action = "replace"
    target_label = "app"
  }

  // Label creation -  "job" field from "__meta_kubernetes_namespace" and "__meta_kubernetes_pod_container_name"
  // Concatenate values __meta_kubernetes_namespace/__meta_kubernetes_pod_container_name
  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
    action = "replace"
    target_label = "job"
    separator = "/"
    replacement = "$1"
  }

  // Label creation - "__path__" field from "__meta_kubernetes_pod_uid" and "__meta_kubernetes_pod_container_name"
  // Concatenate values __meta_kubernetes_pod_uid/__meta_kubernetes_pod_container_name.log
  rule {
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    action = "replace"
    target_label = "__path__"
    separator = "/"
    replacement = "/var/log/pods/*$1/*.log"
  }

  // Label creation -  "container_runtime" field from "__meta_kubernetes_pod_container_id"
  rule {
    source_labels = ["__meta_kubernetes_pod_container_id"]
    action = "replace"
    target_label = "container_runtime"
    regex = "^(\\S+):\\/\\/.+$"
    replacement = "$1"
  }
}

// loki.source.kubernetes tails logs from Kubernetes containers using the Kubernetes API.
loki.source.kubernetes "pod_logs" {
  targets    = discovery.relabel.pod_logs.output
  forward_to = [loki.process.pod_logs.receiver]
}

// loki.process receives log entries from other Loki components, applies one or more processing stages,
// and forwards the results to the list of receivers in the component's arguments.
loki.process "pod_logs" {
  stage.static_labels {
      values = {
        cluster = "production",
      }
  }

  forward_to = [loki.write.default.receiver]
}

// loki.source.kubernetes_events tails events from the Kubernetes API and converts them
// into log lines to forward to other Loki components.
loki.source.kubernetes_events "cluster_events" {
  job_name   = "integrations/kubernetes/eventhandler"
  log_format = "logfmt"
  forward_to = [
    loki.process.cluster_events.receiver,
  ]
}

// loki.process receives log entries from other loki components, applies one or more processing stages,
// and forwards the results to the list of receivers in the component's arguments.
loki.process "cluster_events" {
  forward_to = [loki.write.default.receiver]

  stage.static_labels {
    values = {
      cluster = "production",
    }
  }

  stage.labels {
    values = {
      kubernetes_cluster_events = "job",
    }
  }
}
