logging {
  level = "info"
  format = "logfmt"
}

loki.write "default" {
  endpoint {
    // Staging Loki runs deploymentMode: SingleBinary with write.replicas: 0, so
    // the chart never renders a loki-write Service. This pointed at loki-write
    // (copied from production, which runs SimpleScalable), so every push failed
    // and staging Loki has never received a log line. loki-gateway is the same
    // endpoint the staging Grafana datasource already reads from.
    url = "http://loki-gateway.monitoring.svc.cluster.local:80/loki/api/v1/push"
  }
}
// Redacts credentials before anything is written to Loki.
//
// Nightscout authenticates with a `token=` / `secret=` query parameter, so its
// own logs, Traefik access logs and Kubernetes events all carry working
// credentials in the URL. Loki retains 30 days of that, searchable by anyone
// who reaches Grafana.
//
// This is a single chokepoint that EVERY source routes through, rather than a
// stage on one pipeline: pod logs and cluster events each reached loki.write
// independently, so scrubbing only `pod_logs` (as originally proposed) would
// have left cluster events untouched. Adding a source later means pointing it
// at this component instead of loki.write.default. Kept byte-identical to the
// production config so the two cannot drift apart.
//
// Unlike stage.match, stage.replace has no effect on entries that do not match —
// non-matching lines pass through byte-identical — so putting this in the
// delivery path cannot drop logs. (That risk is why the journal metrics branch
// below is kept as a separate dead end.)
//
// stage.replace substitutes only the CAPTURE GROUP, not the whole match, so the
// surrounding context survives: `?token=abc123` becomes `?token=REDACTED`, which
// keeps the line useful for debugging while the credential is gone. Every
// pattern therefore captures the value alone and leaves the key name uncaptured.
loki.process "scrub" {
  forward_to = [loki.write.default.receiver]

  // Auth headers. The scheme is matched but deliberately not captured, so
  // `Authorization: Bearer <jwt>` redacts to `Authorization: Bearer REDACTED`
  // and still shows which scheme was used.
  stage.replace {
    expression = "(?i)\\b(?:api[-_]secret|x[-_]api[-_]key|authorization)\\s*:\\s*(?:bearer\\s+|basic\\s+)?([^\\s,;\"]+)"
    replace    = "REDACTED"
  }

  // Bare `Bearer <token>` outside a recognised header. The {8,} bound stops it
  // matching ordinary prose such as "Bearer token was rejected".
  stage.replace {
    expression = "(?i)\\b(?:bearer|basic)\\s+([A-Za-z0-9._~+/=-]{8,})"
    replace    = "REDACTED"
  }

  // Credentials as query parameters or logfmt fields — the Nightscout case.
  // `pwd` is matched case-sensitively: sudo logs `PWD=<cwd>`, which is a
  // working directory, and redacting it cost the line its only useful field.
  // This also redacts the VALUE of any `secret=` field, which in a Kubernetes
  // event may be a Secret's name rather than its contents. Losing a resource
  // name from a log line is a deliberate trade against leaking a live token.
  stage.replace {
    expression = "\\b(?:(?i:token|secret|api[-_]?key|apikey|access[-_]?token|password|passwd)|pwd)=([^&\\s\"]+)"
    replace    = "REDACTED"
  }
}

// No node-level log collection in staging, deliberately.
//
// This previously held a loki.source.file tailing /var/log/syslog, copied from
// the production config. It collected nothing: k3d "nodes" are containers, not
// hosts. Verified on k3d-staging-agent-0 -- PID 1 is docker-init, there is no
// journald binary, no /var/log/journal, and no /var/log/syslog.
//
// Production solves this with loki.source.journal (see the production
// config.alloy), which is not portable here because there is no journal to
// read. Anything k3s itself logs in staging goes to the k3d node container's
// stdout, which lives outside the cluster and is reachable via `docker logs`
// on the Proxmox VM rather than through Alloy.
//
// Pod logs are unaffected and continue below via loki.source.kubernetes, which
// reads through the Kubernetes API rather than from files.

// discovery.kubernetes allows you to find scrape targets from Kubernetes resources.
// It watches cluster state and ensures targets are continually synced with what is currently running in your cluster.
discovery.kubernetes "pod" {
  role = "pod"
  // Restrict to pods on the node to reduce cpu & memory usage
  selectors {
    role = "pod"
    field = "spec.nodeName=" + coalesce(sys.env("HOSTNAME"), constants.hostname)
  }
}

// discovery.relabel rewrites the label set of the input targets by applying one or more relabeling rules.
// If no rules are defined, then the input targets are exported as-is.
discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pod.targets

  // Label creation - "namespace" field from "__meta_kubernetes_namespace"
  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    action = "replace"
    target_label = "namespace"
  }

  // Label creation - "pod" field from "__meta_kubernetes_pod_name"
  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    action = "replace"
    target_label = "pod"
  }

  // Label creation - "container" field from "__meta_kubernetes_pod_container_name"
  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    action = "replace"
    target_label = "container"
  }

  // Label creation -  "app" field from "__meta_kubernetes_pod_label_app_kubernetes_io_name"
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    action = "replace"
    target_label = "app"
  }

  // Label creation -  "job" field from "__meta_kubernetes_namespace" and "__meta_kubernetes_pod_container_name"
  // Concatenate values __meta_kubernetes_namespace/__meta_kubernetes_pod_container_name
  rule {
    source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_container_name"]
    action = "replace"
    target_label = "job"
    separator = "/"
    replacement = "$1"
  }

  // Label creation - "__path__" field from "__meta_kubernetes_pod_uid" and "__meta_kubernetes_pod_container_name"
  // Concatenate values __meta_kubernetes_pod_uid/__meta_kubernetes_pod_container_name.log
  rule {
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    action = "replace"
    target_label = "__path__"
    separator = "/"
    replacement = "/var/log/pods/*$1/*.log"
  }

  // Label creation -  "container_runtime" field from "__meta_kubernetes_pod_container_id"
  rule {
    source_labels = ["__meta_kubernetes_pod_container_id"]
    action = "replace"
    target_label = "container_runtime"
    regex = "^(\\S+):\\/\\/.+$"
    replacement = "$1"
  }
}

// loki.source.kubernetes tails logs from Kubernetes containers using the Kubernetes API.
loki.source.kubernetes "pod_logs" {
  targets    = discovery.relabel.pod_logs.output
  forward_to = [loki.process.pod_logs.receiver]
}

// loki.process receives log entries from other Loki components, applies one or more processing stages,
// and forwards the results to the list of receivers in the component's arguments.
loki.process "pod_logs" {
  stage.static_labels {
      values = {
        cluster = "staging",
      }
  }

  // Drop what Loki is going to refuse anyway.
  //
  // loki.source.kubernetes keeps its read position in memory, so a
  // re-established tail restarts at the beginning of the container's log. For
  // a pod that started weeks ago and has logged almost nothing since — the
  // barman-cloud sidecar, csi-provisioner, a kube-system load balancer — that
  // replays the same handful of startup lines over and over. Once those lines
  // are older than Loki's reject_old_samples_max_age (7 days by default, which
  // neither cluster overrides) every replay comes back as:
  //
  //   400: entry for stream '{container="barman-cloud", ...}' has timestamp
  //   too old: 2026-08-11T00:27:21Z, oldest acceptable timestamp is:
  //   2026-08-19T11:13:39Z
  //
  // Nothing was being lost: Loki ingests the valid entries in the same push
  // and refuses only these, and these are duplicates of lines it stored two
  // weeks ago. But alloy reports the whole batch at error level as "dropping
  // data", ~20 lines an hour, for a condition that is neither new nor
  // actionable — and an error nobody can act on is one everybody learns to
  // scroll past.
  //
  // 160h rather than 168h so the margin belongs to us: an entry that squeaks
  // under the wire here and spends the next hour in a batch queue would arrive
  // on the far side of Loki's cutoff and be refused again.
  //
  // Raising reject_old_samples_max_age instead would "fix" it by admitting
  // fortnight-old duplicates into storage, which is worse than the noise.
  //
  // Deliberately counted, not silent: loki_process_dropped_lines_total carries
  // the reason, so if this ever starts dropping something real the number is
  // there to see.
  stage.drop {
    older_than          = "160h"
    drop_counter_reason = "older_than_loki_accepts"
  }

  forward_to = [loki.process.scrub.receiver]
}

// loki.source.kubernetes_events tails events from the Kubernetes API and converts them
// into log lines to forward to other Loki components.
loki.source.kubernetes_events "cluster_events" {
  job_name   = "integrations/kubernetes/eventhandler"
  log_format = "logfmt"
  forward_to = [
    loki.process.cluster_events.receiver,
  ]
}

// loki.process receives log entries from other loki components, applies one or more processing stages,
// and forwards the results to the list of receivers in the component's arguments.
loki.process "cluster_events" {
  forward_to = [loki.process.scrub.receiver]

  stage.static_labels {
    values = {
      cluster = "staging",
    }
  }

  stage.labels {
    values = {
      kubernetes_cluster_events = "job",
    }
  }
}
